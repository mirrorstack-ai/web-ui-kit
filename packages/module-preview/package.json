{
  "name": "@mirrorstack-ai/module-preview",
  "version": "0.7.17",
  "description": "The console's page shell, rendered on localhost so a module's surface can be reviewed without a platform: the real frame width, the host's header chrome, the host's unsaved bar, and the theme/locale/scene axes a review has to cover.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirrorstack-ai/web-ui-kit.git",
    "directory": "packages/module-preview"
  },
  "bugs": {
    "url": "https://github.com/mirrorstack-ai/web-ui-kit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@mirrorstack-ai/web-ui-kit": ">=0.7.17",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@mirrorstack-ai/web-ui-kit": "workspace:*",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
